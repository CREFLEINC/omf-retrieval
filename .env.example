# Copy to /opt/omf-retrieval/.env, replace every angle-bracket placeholder,
# and keep the resulting file mode at 0600.
OMF_APP_UID=<HOST_UID>
OMF_APP_GID=<HOST_GID>

POSTGRES_DB=omf_retrieval
POSTGRES_USER=omf_retrieval
OMF_RETRIEVAL_DATABASE_URL=postgresql+psycopg://omf_retrieval:<URL_SAFE_PASSWORD>@postgres:5432/omf_retrieval

OMF_POSTGRES_DATA_DIR=/home/storage_disk3/omf-retrieval-disk/postgres
OMF_MODEL_CACHE_DIR=/home/storage_disk3/omf-retrieval-disk/model-cache
OMF_SOURCE_REPO_DIR=/home/storage_disk3/omf-retrieval-disk/source/omf
OMF_POSTGRES_PASSWORD_FILE=/opt/omf-retrieval/secrets/postgres_password
OMF_AUDIT_HMAC_KEY_FILE=/opt/omf-retrieval/secrets/audit_hmac_key

OMF_BIND_ADDRESS=192.168.1.185
OMF_PUBLIC_PORT=9090
